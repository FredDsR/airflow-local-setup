# Copy to .env in this directory. Compose uses it both for ${...} substitution
# inside docker-compose.yaml and as the env_file handed to the containers.

# Must match your host user (`id -u`), otherwise files written to logs/ by the
# container end up owned by uid 50000.
AIRFLOW_UID=1000

# Connection URI for the `aws_s3` Airflow connection. Generate it with
# `uv run get_conn_uri.py`; the key and secret must be URL encoded.
AIRFLOW_CONN_AWS_S3='aws://<aws_access_key>:<aws_secret_access_key>@'
